# Preserve exact Unity source bytes for verified restoration.
Assets/** -text
Packages/** -text
ProjectSettings/** -text
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.png binary
*.pdf binary
# Override JSON for original package configuration.
Packages/** -text
ProjectSettings/** -text

# Localization JSON must also match the build-source manifest byte for byte.
Assets/** -text
# Unity metadata commonly leaves optional values blank after the colon.
*.meta whitespace=cr-at-eol,-blank-at-eol
